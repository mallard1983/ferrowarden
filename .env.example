# .env.example — copy to .env (gitignored) and edit. Docker Compose reads .env
# from the project directory automatically. Secrets do NOT go here: they live
# in secrets/ (see docs/setup.md).

# ── Vaultwarden web vault (your password manager) ───────────────────────────

# Where the web vault is published on this host. Loopback by default; use
# 0.0.0.0 so a reverse proxy (e.g. Pangolin, target https://<host>:8443) or
# LAN clients can reach it.
VAULTWARDEN_PUBLISH=127.0.0.1
VAULTWARDEN_PORT=8443

# The URL you open the web vault at. Behind a reverse proxy, its public URL.
VAULTWARDEN_DOMAIN=https://127.0.0.1:8443
# VAULTWARDEN_DOMAIN=https://vault.example.com

# Extra names/IPs on the web vault's certificate (issued by the internal CA),
# for browsing to it directly on your LAN. Not needed behind a reverse proxy
# with its own certificate.
VAULTWARDEN_CERT_SANS=localhost,127.0.0.1
# VAULTWARDEN_CERT_SANS=localhost,127.0.0.1,vault.lan,192.168.1.20

# Leave false. Set to true only on the command line, while creating your
# first account:  VAULTWARDEN_SIGNUPS_ALLOWED=true docker compose up -d vaultwarden
VAULTWARDEN_SIGNUPS_ALLOWED=false

# ── Ferrowarden ─────────────────────────────────────────────────────────────

# Where the agent API is published on this host.
FERROWARDEN_PUBLISH=0.0.0.0
FERROWARDEN_PORT=3000

# Private/internal targets agents may reach (CIDRs, IPs or host names).
# Public targets need no entry. bw serve is always blocked.
FERROWARDEN_ALLOWED_TARGETS=
# FERROWARDEN_ALLOWED_TARGETS=192.168.1.0/24,proxmox.lan

# Reverse proxies whose X-Forwarded-For header is trusted for rate limiting.
FERROWARDEN_TRUSTED_PROXIES=
# FERROWARDEN_TRUSTED_PROXIES=172.17.0.1

# Optional hard-to-guess path prefix for the API (everything except /health).
FERROWARDEN_API_PREFIX=
# FERROWARDEN_API_PREFIX=/k7f3q9

# How often (seconds) credentials added or changed in the web vault become
# usable by agents. Empty = 300.
FERROWARDEN_REFRESH_INTERVAL_SECS=

# Agent endpoint rate limit per client IP. Empty = 120 per minute, burst 20.
FERROWARDEN_AGENT_RATE_LIMIT_PER_MINUTE=
FERROWARDEN_AGENT_RATE_LIMIT_BURST=

# Admin endpoint rate limit per client IP. Empty = 30 per minute, burst 5.
# Keep it low: it slows down guessing of the admin key.
FERROWARDEN_ADMIN_RATE_LIMIT_PER_MINUTE=
FERROWARDEN_ADMIN_RATE_LIMIT_BURST=
