# .env.example — copy to .env (gitignored) and edit. Docker Compose reads .env
# from the project directory automatically. Secrets do NOT go here: they live
# in secrets/ (see docs/setup.md).

# ── Vaultwarden web vault (your password manager) ───────────────────────────

# Where the web vault is published on this host. Loopback by default; use
# 0.0.0.0 so a reverse proxy (e.g. Pangolin, target https://<host>:8443) or
# LAN clients can reach it.
VAULTWARDEN_PUBLISH=127.0.0.1
VAULTWARDEN_PORT=8443

# The URL you open the web vault at. Behind a reverse proxy, its public URL.
VAULTWARDEN_DOMAIN=https://127.0.0.1:8443
# VAULTWARDEN_DOMAIN=https://vault.example.com

# Extra names/IPs on the web vault's certificate (issued by the internal CA),
# for browsing to it directly on your LAN. Not needed behind a reverse proxy
# with its own certificate.
VAULTWARDEN_CERT_SANS=localhost,127.0.0.1
# VAULTWARDEN_CERT_SANS=localhost,127.0.0.1,vault.lan,192.168.1.20

# Leave false. Set to true only on the command line, while creating your
# first account:  VAULTWARDEN_SIGNUPS_ALLOWED=true docker compose up -d vaultwarden
VAULTWARDEN_SIGNUPS_ALLOWED=false

# ── Ferrowarden ─────────────────────────────────────────────────────────────

# Where the agent API is published on this host.
FERROWARDEN_PUBLISH=0.0.0.0
FERROWARDEN_PORT=3000

# Private/internal targets agents may reach (CIDRs, IPs or host names).
# Public targets need no entry. bw serve is always blocked.
FERROWARDEN_ALLOWED_TARGETS=
# FERROWARDEN_ALLOWED_TARGETS=192.168.1.0/24,proxmox.lan

# Reverse proxies whose X-Forwarded-For header is trusted for rate limiting.
FERROWARDEN_TRUSTED_PROXIES=
# FERROWARDEN_TRUSTED_PROXIES=172.17.0.1

# Optional hard-to-guess path prefix for the API (everything except /health).
FERROWARDEN_API_PREFIX=
# FERROWARDEN_API_PREFIX=/k7f3q9

# How often (seconds) credentials added or changed in the web vault become
# usable by agents. Empty = 300.
FERROWARDEN_REFRESH_INTERVAL_SECS=

# The vault backend (docs/native-vault.md): bw serve (default) or the native
# client, which reads the vault itself and needs no bw-serve container. The
# switch is made in docker-compose.yml (commented FERROWARDEN_VAULT__* lines)
# because it also changes which secrets the service mounts:
#   FERROWARDEN_VAULT__BACKEND=native
#   FERROWARDEN_VAULT_CLIENT_ID_FILE=/run/secrets/bw_client_id
#   FERROWARDEN_VAULT_CLIENT_SECRET_FILE=/run/secrets/bw_client_secret
#   FERROWARDEN_VAULT__URL=https://vaultwarden      (default)
#   FERROWARDEN_VAULT__CA_FILE=/ca-public/ca.crt    (the Compose file sets it)

# Agent endpoint rate limit per client IP. Empty = 120 per minute, burst 20.
FERROWARDEN_AGENT_RATE_LIMIT_PER_MINUTE=
FERROWARDEN_AGENT_RATE_LIMIT_BURST=

# Admin endpoint rate limit per client IP. Empty = 30 per minute, burst 5.
# Keep it low: it slows down guessing of the admin key.
FERROWARDEN_ADMIN_RATE_LIMIT_PER_MINUTE=
FERROWARDEN_ADMIN_RATE_LIMIT_BURST=

# Security event stream (docs/events.md). Defaults: events to stdout, 1000 kept
# in memory for GET /v1/admin/audit. To also write a rotating JSON-lines file or
# forward to syslog, set these in docker-compose.yml (FERROWARDEN_EVENTS__*) or
# in ferrowarden.toml under [events]:
#   FERROWARDEN_EVENTS__FILE=/data/events/events.jsonl
#   FERROWARDEN_EVENTS__SYSLOG=tls://wazuh.example.lan:6514

# Push notifications (docs/notifications.md): off unless a sender URL is set in
# docker-compose.yml (FERROWARDEN_NOTIFY__*). Tokens go in secret files, not here:
#   FERROWARDEN_NOTIFY__GOTIFY_URL=https://gotify.example.com
#   FERROWARDEN_NOTIFY_GOTIFY_TOKEN_FILE=/run/secrets/gotify_token
#   FERROWARDEN_NOTIFY__NTFY_URL=https://ntfy.example.com/ferrowarden
#   FERROWARDEN_NOTIFY__WEBHOOK_URL=https://hooks.example.com/ferrowarden
#   FERROWARDEN_NOTIFY__EVENTS=blocked,auth_failure,vault,system

# Prometheus metrics (docs/metrics.md): off unless a bind address is set in
# docker-compose.yml (FERROWARDEN_METRICS__BIND, and publish that port only on
# a network you trust). The bearer token goes in a secret file, not here:
#   FERROWARDEN_METRICS__BIND=0.0.0.0:9095
#   FERROWARDEN_METRICS_TOKEN_FILE=/run/secrets/metrics_token
#   FERROWARDEN_METRICS__CREDENTIAL_LABELS=false   # true: vault item names become labels

# Admin web UI (docs/admin-ui.md): off unless a bind address is set in
# docker-compose.yml (FERROWARDEN_UI__BIND, and publish that port). It accepts
# the vault master password, so it needs HTTPS: a TLS reverse proxy listed in
# FERROWARDEN_TRUSTED_PROXIES above, or Ferrowarden's own TLS. The compose file
# mounts the internal CA certificate (never its key) for the Vaultwarden check.
#   FERROWARDEN_UI__BIND=0.0.0.0:3001
