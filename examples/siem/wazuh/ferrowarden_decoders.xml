<!--
  Decoders for Ferrowarden security events (docs/events.md, schema_version 1).

  Two ways in; both give the same dynamic fields (event.action, event.outcome,
  event.reason, source.ip, ferrowarden.key.name, ...), which the rules match on
  and which show up in alerts as data.<field>.

  1. File sink, read by a Wazuh agent with <log_format>json</log_format> (see
     ossec-localfile.xml). Wazuh's built-in "json" decoder
     (ruleset/decoders/0006-json_decoders.xml) already parses these lines, so no
     decoder is needed here. Do NOT add a child decoder of "json" for them: in
     Wazuh 4.14 a matching child decoder discards the fields the JSON decoder
     extracted. The rules select Ferrowarden lines with the field
     event.dataset = ferrowarden.security instead.

  2. Syslog sink (RFC 5424, APP-NAME "ferrowarden"), where the JSON event is the
     MSG part:
       <36>1 2026-11-21T16:09:23.492Z host ferrowarden 1 agent_auth - {"@timestamp":...}
     The decoder below matches the header (with or without the leading <PRI>:
     Wazuh's remoted may strip it) and hands the JSON after it to the JSON
     decoder. Written as \x3C / \x3E because the decoder XML does not decode
     &lt; / &gt; in a prematch.

  Install on the manager as /var/ossec/etc/decoders/ferrowarden_decoders.xml
  (the rules also work without this file if you only use the file sink).
-->

<decoder name="ferrowarden-syslog">
  <prematch type="pcre2">^(?:\x3C\d{1,3}\x3E)?1 \S+ \S+ ferrowarden \S+ \S+ - (?=\{)</prematch>
  <plugin_decoder offset="after_prematch">JSON_Decoder</plugin_decoder>
</decoder>
