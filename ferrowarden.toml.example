# ferrowarden.toml.example
#
# Copy this file to ferrowarden.toml and edit for your deployment.
# DO NOT check a filled-in ferrowarden.toml into version control —
# the .gitignore already excludes it.
#
# NEVER set admin_key here. It must come from the environment variable
# FERROWARDEN_ADMIN_KEY. This is enforced at startup; ferrowarden will
# refuse to start if the key is absent or fewer than 32 characters.
#
# All settings can also be set via environment variable using the
# FERROWARDEN_ prefix. Environment variables override file values.
# Example: FERROWARDEN_BIND_ADDR=0.0.0.0:3000


# ── Server ──────────────────────────────────────────────────────────────────

# Address and port the ferrowarden HTTP server listens on.
# When running in Docker with the agent on the same host: 0.0.0.0:3000
# When running directly on a host (not Docker): 127.0.0.1:3000
# Never expose this port to the public internet.
bind_addr = "0.0.0.0:3000"


# ── Vault ────────────────────────────────────────────────────────────────────

# URL of the bw serve process.
# bw serve must only be reachable from ferrowarden — never expose its port
# externally. In Docker Compose this is the service name. On a bare host
# it must be 127.0.0.1 (localhost).
bw_serve_url = "http://127.0.0.1:8087"

# How the vault master password is supplied at startup.
# "file"   — ferrowarden reads the password from unlock_file once at boot,
#            calls bw serve's POST /unlock, then zeros the value from memory.
#            Use this in Docker with a Docker secret or a chmod 400 bind mount.
# "manual" — ferrowarden starts locked. The operator POSTs the master password
#            to POST /v1/unlock (admin auth required) after each restart.
#            Appropriate when you want explicit human confirmation per boot.
unlock_mode = "file"

# Path to the master password file. Required when unlock_mode = "file".
# Ignored when unlock_mode = "manual".
#
# Docker secret:   /run/secrets/bw_master_password
# Bind mount:      /etc/ferrowarden/unlock.key  (chmod 400, owned by the process user)
#
# The file must contain only the master password. A single trailing newline
# is tolerated and stripped; all other content is treated as part of the password.
unlock_file = "/run/secrets/bw_master_password"


# ── Agent key persistence ─────────────────────────────────────────────────────

# Path to the agent key store file. Optional.
# When set, agent keys survive container restarts. The file stores only
# SHA-256 hashes of tokens — plaintext is never written to disk.
# Omit to use in-memory-only storage (keys are lost when the process stops).
#
# Docker: use a named volume mounted at /data and set this to /data/agent_keys.json
# Bare host: any writable path, e.g. /var/lib/ferrowarden/agent_keys.json
#
# keys_file = "/data/agent_keys.json"


# ── Outbound targets and credential binding ─────────────────────────────────

# Credentials are only sent to hosts listed in their Vaultwarden login item's
# URIs (e.g. https://api.example.com, nas.lan, https://proxmox.lan:8006).
# An item with no URIs cannot be used. Turning this off lets any agent send
# any credential to any reachable host — including one that echoes it back.
enforce_credential_hosts = true

# Private, loopback, link-local (cloud metadata) and other internal addresses
# are blocked as targets by default. List the internal targets agents need:
# CIDRs, single IPs, or host names, comma-separated. bw serve is always blocked.
# allowed_targets = "192.168.1.0/24,proxmox.lan"

# Allow ALL private/internal targets. Prefer allowed_targets.
allow_private_targets = false

# Seconds between bw serve syncs / credential cache refreshes. The refresher
# also re-unlocks bw serve in file mode if it restarted. 0 disables it.
refresh_interval_secs = 300

# Forwarded request timeout (seconds) and maximum response size (bytes).
forward_timeout_secs = 30
max_response_bytes = 10485760


# ── Rate limiting behind a reverse proxy ────────────────────────────────────

# CIDRs/IPs of reverse proxies in front of ferrowarden (e.g. Pangolin). When a
# request comes from one of these, the client IP for rate limiting is read from
# X-Forwarded-For. Leave empty if clients connect directly.
# trusted_proxies = "172.16.0.0/12"


# ── Agent rate limit ────────────────────────────────────────────────────────

# Per client IP, on /v1/forward and /v1/credentials. Requests beyond the burst
# are limited to the sustained rate and get 429 with Retry-After.
# agent_rate_limit_per_minute = 120
# agent_rate_limit_burst = 20


# ── API path prefix ─────────────────────────────────────────────────────────

# Serve every API route except /health under this prefix, e.g. "/k7f3q9"
# moves /v1/forward to /k7f3q9/v1/forward and makes /v1/... return 404.
# Path segments of letters, digits, '-' and '_'. Obscurity, not
# authentication — useful for reverse-proxy bypass rules and scanner noise.
# api_prefix = "/k7f3q9"


# ── TLS ──────────────────────────────────────────────────────────────────────
#
# TLS is ENABLED by default. You must supply a certificate and key before
# starting ferrowarden, or it will refuse to start.
#
# See certs/README.md for instructions on generating certificates.

# Whether to enable TLS. Default: true.
#
# Set to false ONLY when both conditions are met:
#   1. ferrowarden and the agent run on the same host (no network hop).
#   2. You fully accept that credential values will be transmitted as
#      plaintext and are comfortable with the risk.
#
# When false, ferrowarden will log a prominent multi-line warning at startup.
# This is intentional — plaintext HTTP is a security downgrade that should
# never happen silently.
tls_enabled = true

# Path to the TLS certificate (PEM format). Required when tls_enabled = true.
# Docker Compose: mount certs/ as a bind volume and set to /run/certs/server.crt
# Bare host:      path to the cert file, e.g. /etc/ferrowarden/certs/server.crt
tls_cert_file = "/run/certs/server.crt"

# Path to the TLS private key (PEM format). Required when tls_enabled = true.
# The key must correspond to the certificate above.
# File permissions: chmod 400, owned by the ferrowarden process user.
# Docker Compose: /run/certs/server.key
tls_key_file = "/run/certs/server.key"


# ── Logging ──────────────────────────────────────────────────────────────────
#
# Log level is set via environment variable only — not in this file.
# This is intentional: changing the log level requires a container restart,
# which produces an auditable event. See docs/logging.md for details.
#
# Set FERROWARDEN_LOG_LEVEL in docker-compose.yml or the host environment.
# Valid values: trace | debug | info | warn | error
# Default: info
#
# Module-scoped filtering is supported:
#   FERROWARDEN_LOG_LEVEL="ferrowarden=debug,tower_http=warn"
