# ferrowarden.toml.example
#
# Copy this file to ferrowarden.toml and edit for your deployment.
# DO NOT check a filled-in ferrowarden.toml into version control —
# the .gitignore already excludes it.
#
# NEVER set admin_key here. It must come from the environment variable
# FERROWARDEN_ADMIN_KEY, or from the file that FERROWARDEN_ADMIN_KEY_FILE
# names (a Docker secret; read by ferrowarden itself, never exported). This is
# enforced at startup; ferrowarden will refuse to start if the key is absent
# or fewer than 32 characters.
#
# All settings can also be set via environment variable using the
# FERROWARDEN_ prefix. Environment variables override file values.
# Example: FERROWARDEN_BIND_ADDR=0.0.0.0:3000


# ── Server ──────────────────────────────────────────────────────────────────

# Address and port the ferrowarden HTTP server listens on.
# When running in Docker with the agent on the same host: 0.0.0.0:3000
# When running directly on a host (not Docker): 127.0.0.1:3000
# Never expose this port to the public internet.
bind_addr = "0.0.0.0:3000"


# ── Vault ────────────────────────────────────────────────────────────────────

# Which backend reads the vault: "native" (default) or "bw-serve" (deprecated,
# removed in the release after 0.2.0).
#   native:   Ferrowarden speaks the Bitwarden protocol to Vaultwarden itself
#             (no bw CLI, no Node): it keeps the vault as ciphertext and decrypts
#             one value per request. Needs [vault] url and the Vaultwarden API key
#             (FERROWARDEN_VAULT_CLIENT_ID_FILE / FERROWARDEN_VAULT_CLIENT_SECRET_FILE).
#             See docs/native-vault.md and the trade-off in docs/security.md.
#   bw-serve: DEPRECATED. The Bitwarden CLI's `bw serve` REST API, at
#             bw_serve_url below. Ferrowarden logs a warning at every start.
# [vault]
# backend = "native"                      # FERROWARDEN_VAULT__BACKEND (the default)
# url = "https://vaultwarden"             # FERROWARDEN_VAULT__URL; https:// (http only for localhost)
# ca_file = "/ca-public/ca.crt"           # FERROWARDEN_VAULT__CA_FILE; extra CA (PEM), never the CA key
#                                         # (replaces ui.vaultwarden_url / ui.vaultwarden_ca_file)
# allow_hidden_passwords = false          # FERROWARDEN_VAULT__ALLOW_HIDDEN_PASSWORDS
#   An organisation collection can be shared with this account as "Hide
#   passwords" (the server marks its items viewPassword = false). By default
#   the native backend leaves such items out (reason hidden_password in the
#   vault_sync event); true makes them usable by agents (a startup warning and
#   the startup event say so). The deprecated bw serve withholds those
#   passwords itself, so the setting has no effect there. See
#   docs/native-vault.md.
# In native mode bw_serve_url below is ignored. The API key comes only from the
# environment or secret files, never from this file.

# DEPRECATED (backend = "bw-serve" only; removed in the release after 0.2.0).
# URL of the bw serve process.
# bw serve must only be reachable from ferrowarden — never expose its port
# externally. In Docker Compose this is the service name. On a bare host
# it must be 127.0.0.1 (localhost).
bw_serve_url = "http://127.0.0.1:8087"

# How the vault master password is supplied at startup.
# "file"   — ferrowarden reads the password from unlock_file once at boot,
#            unlocks the vault with it (the native backend derives the keys
#            from it; the deprecated bw serve gets POST /unlock), then zeros
#            the value from memory. In this mode one process holds both the
#            API key and the master password; "manual" is the hardened option
#            (docs/security.md).
#            Use this in Docker with a Docker secret or a chmod 400 bind mount.
# "manual" — ferrowarden starts locked. The operator POSTs the master password
#            to POST /v1/unlock (admin auth required) after each restart.
#            Appropriate when you want explicit human confirmation per boot.
unlock_mode = "file"

# Path to the master password file. Required when unlock_mode = "file".
# Ignored when unlock_mode = "manual".
#
# Docker secret:   /run/secrets/bw_master_password
# Bind mount:      /etc/ferrowarden/unlock.key  (chmod 400, owned by the process user)
#
# The file must contain only the master password. A single trailing newline
# is tolerated and stripped; all other content is treated as part of the password.
unlock_file = "/run/secrets/bw_master_password"


# ── Agent key persistence ─────────────────────────────────────────────────────

# Path to the agent key store file. Optional.
# When set, agent keys survive container restarts. The file stores only
# SHA-256 hashes of tokens — plaintext is never written to disk.
# Omit to use in-memory-only storage (keys are lost when the process stops).
#
# Docker: use a named volume mounted at /data and set this to /data/agent_keys.json
# Bare host: any writable path, e.g. /var/lib/ferrowarden/agent_keys.json
#
# keys_file = "/data/agent_keys.json"


# ── Outbound targets and credential binding ─────────────────────────────────

# Credentials are only sent to hosts listed in their Vaultwarden login item's
# URIs (e.g. https://api.example.com, nas.lan, https://proxmox.lan:8006).
# An item with no URIs cannot be used. Turning this off lets any agent send
# any credential to any reachable host — including one that echoes it back.
enforce_credential_hosts = true

# Private, loopback, link-local (cloud metadata) and other internal addresses
# are blocked as targets by default. List the internal targets agents need:
# CIDRs, single IPs, or host names, comma-separated. The vault endpoint is always blocked.
# allowed_targets = "192.168.1.0/24,proxmox.lan"

# Allow ALL private/internal targets. Prefer allowed_targets.
allow_private_targets = false

# Seconds between vault syncs / credential cache refreshes. The refresher
# also re-unlocks the vault in file mode if it locked. 0 disables it.
refresh_interval_secs = 300

# Forwarded request timeout (seconds) and maximum response size (bytes).
forward_timeout_secs = 30
max_response_bytes = 10485760


# ── Rate limiting behind a reverse proxy ────────────────────────────────────

# CIDRs/IPs of reverse proxies in front of ferrowarden (e.g. Pangolin). When a
# request comes from one of these, the client IP for rate limiting is read from
# X-Forwarded-For. Leave empty if clients connect directly.
# trusted_proxies = "172.16.0.0/12"


# ── Agent rate limit ────────────────────────────────────────────────────────

# Per client IP, on /v1/forward and /v1/credentials. Requests beyond the burst
# are limited to the sustained rate and get 429 with Retry-After.
# agent_rate_limit_per_minute = 120
# agent_rate_limit_burst = 20
# Admin endpoints (/v1/admin/*, /v1/unlock). Keep these low: they slow down
# guessing of the admin key.
# admin_rate_limit_per_minute = 30
# admin_rate_limit_burst = 5


# ── Security events ─────────────────────────────────────────────────────────
#
# Every security-relevant action (forwards, auth failures, key changes, vault
# lock/unlock, startup/shutdown, ...) produces one structured JSON event. See
# docs/events.md for the schema. Everything below is the default; uncomment
# to change it. Environment: FERROWARDEN_EVENTS__<KEY>, e.g.
# FERROWARDEN_EVENTS__FILE=/data/events/events.jsonl
#
# [events]
# stdout = true               # JSON lines on stdout (event.dataset = "ferrowarden.security")
# buffer_size = 1000          # events kept in memory for GET /v1/admin/audit
# queue_size = 10000          # events that may wait for the sinks; overflow is dropped and reported
#
# Rotating JSON-lines file (e.g. for a Wazuh agent localfile, log_format json):
# file = "/data/events/events.jsonl"   # empty = off
# file_max_bytes = 52428800            # rotate at 50 MiB
# file_keep = 10                       # events.jsonl.1 ... .10
#
# Syslog, RFC 5424: udp://host:port, tcp://host:port or tls://host:port
# syslog = "tls://wazuh.example.lan:6514"   # empty = off
# syslog_facility = "auth"                  # name (auth, authpriv, daemon, local0-7) or number
# syslog_ca_file = "/run/certs/siem-ca.pem" # extra CA for tls://, besides the public roots


# ── Push notifications ──────────────────────────────────────────────────────
#
# Tell Gotify, ntfy or a generic webhook about blocked requests, repeated
# authentication failures, vault lock/unlock failures and (opt-in) admin changes.
# Off unless a URL is set. Best effort and rate limited; never delays a
# request. See docs/notifications.md. Environment: FERROWARDEN_NOTIFY__<KEY>.
#
# TOKENS ARE NOT SET HERE. Set them in the environment or in a secret file:
#   FERROWARDEN_NOTIFY_GOTIFY_TOKEN  / FERROWARDEN_NOTIFY_GOTIFY_TOKEN_FILE   (required with gotify_url)
#   FERROWARDEN_NOTIFY_NTFY_TOKEN    / FERROWARDEN_NOTIFY_NTFY_TOKEN_FILE     (optional)
#   FERROWARDEN_NOTIFY_WEBHOOK_TOKEN / FERROWARDEN_NOTIFY_WEBHOOK_TOKEN_FILE  (optional, sent as a bearer token)
#
# [notify]
# gotify_url = "https://gotify.example.com"               # POST {gotify_url}/message
# ntfy_url = "https://ntfy.example.com/ferrowarden"       # the full topic URL
# webhook_url = "https://hooks.example.com/ferrowarden"   # JSON POST (Matrix, Slack, ... via their bridges)
# events = ["blocked", "auth_failure", "vault", "system"]   # add "admin" for key changes and UI sign-ins
# min_interval_secs = 60          # per category and subject; the rest are summarised
# max_per_hour = 60               # all notifications together, then one "paused" notice
# auth_failure_threshold = 5      # failed authentications from one IP ...
# auth_failure_window_secs = 300  # ... within this many seconds
# allow_http = false              # true permits http:// URLs for hosts other than this machine
# ca_file = "/run/certs/notifier-ca.pem"   # extra CA for the notifier URLs


# ── Prometheus metrics ──────────────────────────────────────────────────────
#
# Request counts, outcomes, latency, rate limiting, authentication failures and
# vault state for Prometheus, on a listener of its own (never the API or UI
# port) that serves GET /metrics only. Off unless `bind` is set. No metric
# carries a credential value, URL, host, IP, header or placeholder. See
# docs/metrics.md and the Grafana dashboard in examples/grafana.
# Environment: FERROWARDEN_METRICS__<KEY>.
#
# THE TOKEN IS NOT SET HERE. A bearer token is required by default; set it in
# the environment or in a secret file (at least 16 characters):
#   FERROWARDEN_METRICS_TOKEN / FERROWARDEN_METRICS_TOKEN_FILE
# A non-loopback bind with no token is refused at start unless
# allow_unauthenticated is true. With tls_enabled the listener serves TLS with
# the same certificate; without TLS the token crosses the network in clear
# text, so keep that port on an internal-only network.
#
# [metrics]
# bind = "0.0.0.0:9095"            # empty (default) = off; must not be the API or UI port
# allow_unauthenticated = false    # true serves /metrics without a token on a non-loopback bind
# credential_labels = false        # true adds ferrowarden_forward_credential_uses_total{credential=...}:
#                                  # vault item NAMES become labels (capped at 500), which reveals what the vault holds


# ── Admin web UI ────────────────────────────────────────────────────────────
#
# Optional operator UI on its own port (separate from the API): sign in with the
# Vaultwarden master password (two-step login supported), read-only status page.
# Off unless `bind` is set. It accepts the master password, so it only serves
# its sign-in form over HTTPS: its own TLS (tls_enabled) or a reverse proxy
# listed in trusted_proxies that sends X-Forwarded-Proto: https.
# See docs/admin-ui.md. Environment: FERROWARDEN_UI__<KEY>.
#
# [ui]
# bind = "0.0.0.0:3001"                          # empty (default) = UI disabled
# vaultwarden_url / vaultwarden_ca_file: deprecated aliases of [vault] url and
# ca_file (one setting for how Ferrowarden reaches Vaultwarden); still honoured.
# insecure_http = false                          # true = plain-HTTP sign-in form (local testing only)
# session_idle_minutes = 15
# session_max_hours = 8


# ── API path prefix ─────────────────────────────────────────────────────────

# Serve every API route except /health under this prefix, e.g. "/k7f3q9"
# moves /v1/forward to /k7f3q9/v1/forward and makes /v1/... return 404.
# Path segments of letters, digits, '-' and '_'. Obscurity, not
# authentication — useful for reverse-proxy bypass rules and scanner noise.
# api_prefix = "/k7f3q9"


# ── TLS ──────────────────────────────────────────────────────────────────────
#
# TLS is ENABLED by default. You must supply a certificate and key before
# starting ferrowarden, or it will refuse to start.
#
# See certs/README.md for instructions on generating certificates.

# Whether to enable TLS. Default: true.
#
# Set to false ONLY when both conditions are met:
#   1. ferrowarden and the agent run on the same host (no network hop).
#   2. You fully accept that credential values will be transmitted as
#      plaintext and are comfortable with the risk.
#
# When false, ferrowarden will log a prominent multi-line warning at startup.
# This is intentional — plaintext HTTP is a security downgrade that should
# never happen silently.
tls_enabled = true

# Path to the TLS certificate (PEM format). Required when tls_enabled = true.
# Docker Compose: mount certs/ as a bind volume and set to /run/certs/server.crt
# Bare host:      path to the cert file, e.g. /etc/ferrowarden/certs/server.crt
tls_cert_file = "/run/certs/server.crt"

# Path to the TLS private key (PEM format). Required when tls_enabled = true.
# The key must correspond to the certificate above.
# File permissions: chmod 400, owned by the ferrowarden process user.
# Docker Compose: /run/certs/server.key
tls_key_file = "/run/certs/server.key"


# ── Logging ──────────────────────────────────────────────────────────────────
#
# Log level is set via environment variable only — not in this file.
# This is intentional: changing the log level requires a container restart,
# which produces an auditable event. See docs/logging.md for details.
#
# Set FERROWARDEN_LOG_LEVEL in docker-compose.yml or the host environment.
# Valid values: trace | debug | info | warn | error
# Default: info
#
# Module-scoped filtering is supported:
#   FERROWARDEN_LOG_LEVEL="ferrowarden=debug,tower_http=warn"
